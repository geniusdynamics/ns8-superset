#
# Early releases kept every secret in state/superset.env, shared with the
# PostgreSQL container and the web server. Split it in three 0600 files, so
# each container receives only what it needs. Idempotent.
#

import os

state = os.environ["AGENT_STATE_DIR"]
old = os.path.join(state, "superset.env")
if not os.path.exists(old) or os.path.exists(os.path.join(state, "postgres.env")):
    raise SystemExit(0)

values = {}
with open(old) as f:
    for line in f:
        if "=" in line:
            key, value = line.rstrip("\n").split("=", 1)
            values[key] = value

groups = {
    "postgres.env": ["POSTGRES_USER", "POSTGRES_DB", "POSTGRES_PASSWORD"],
    "admin.env": ["NS8_ADMIN_PASSWORD"],
}
groups["superset.env"] = [k for k in values if k not in sum(groups.values(), [])]

# Write the new files first, replace superset.env last: a failure leaves a
# state that this script can process again.
for name in ("postgres.env", "admin.env", "superset.env"):
    path = os.path.join(state, name + ".tmp")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for key in groups[name]:
            f.write(f"{key}={values[key]}\n")
for name in ("postgres.env", "admin.env", "superset.env"):
    os.replace(os.path.join(state, name + ".tmp"), os.path.join(state, name))

# Leftovers of the volume tar backup used by early releases
for name in ("superset-data.tar", "superset-db.tar"):
    try:
        os.remove(os.path.join(state, name))
    except FileNotFoundError:
        pass
