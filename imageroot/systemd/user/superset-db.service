[Unit]
Description=Apache Superset PostgreSQL database
BindsTo=superset.service
PartOf=superset.service
After=superset.service
Before=superset-web.service

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=%E/state/environment
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=75
ExecStart=/usr/bin/podman run --pod superset \
    --env-file=%E/state/postgres.env \
    --volume superset-db:/var/lib/postgresql/data:Z \
    --replace --name %N \
    --sdnotify=conmon --cgroups=no-conmon \
    ${POSTGRES_IMAGE}
ExecStartPost=/usr/bin/timeout 120 /usr/bin/bash -c 'until podman exec %N pg_isready -q -h 127.0.0.1 -U superset -d superset; do sleep 2; done'
ExecStop=/usr/bin/podman stop --ignore -t 30 %N
ExecStopPost=/usr/bin/podman rm --ignore -f %N
