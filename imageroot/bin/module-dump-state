# Runs before the backup, with the state directory as working directory.
# The dump is taken online: the application keeps running.
set -euo pipefail
exec 1>&2
umask 077
echo "Dumping the superset PostgreSQL database"
trap 'rm -f superset.pg_dump.tmp' EXIT
podman exec superset-db pg_dump -U superset --format=c superset > superset.pg_dump.tmp
test -s superset.pg_dump.tmp
mv -f superset.pg_dump.tmp superset.pg_dump
