# Print the initial administrator credentials. Run it on the node as root:
#   runagent -m superset1 superset-initial-credentials
# The password applies to the first start only: it does not follow a
# password change made later from the Superset web interface.
set -e
admin_env="${AGENT_STATE_DIR}/admin.env"
printf 'Username: admin\n'
sed -n 's/^NS8_ADMIN_PASSWORD=/Password: /p' "${admin_env}"
