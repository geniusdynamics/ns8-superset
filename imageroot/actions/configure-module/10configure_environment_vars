import json
import sys
import agent

data = json.load(sys.stdin)

# Only non-secret values here: agent.set_env() is stored in Redis
agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
