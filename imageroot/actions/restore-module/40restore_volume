#!/bin/bash
set -euo pipefail
exec 1>&2
systemctl --user stop superset.service
for volume in superset-data superset-db; do
    podman volume create --ignore "$volume" >/dev/null
    podman unshare bash -ec '
        path=$(podman volume mount "$2")
        if [[ -n $(find "$path" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
            echo "Restore requires an empty superset volume" >&2
            exit 1
        fi
        tar --numeric-owner -C "$path" -xpf "$1"
    ' bash "$PWD/$volume.tar" "$volume"
    rm -f "$volume.tar"
done
