#
# Generate the module secrets once. Each file is created with mode 0600 and
# is never overwritten, so a clone or a restore keeps the original values.
#
#   postgres.env  database superuser, loaded by the PostgreSQL container only
#   superset.env  Superset SECRET_KEY and database URI, loaded by Superset
#   admin.env     initial admin password, loaded by the init step only
#
# Secrets must not go through agent.set_env(): Redis is readable by every
# module on the node.
#

import os
import secrets

state = os.environ["AGENT_STATE_DIR"]


def write_secret(name, values):
    path = os.path.join(state, name)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(fd, "w") as f:
        for key, value in values.items():
            f.write(f"{key}={value}\n")


db_password = secrets.token_hex(32)  # hex: safe inside a database URI
write_secret("postgres.env", {
    "POSTGRES_USER": "superset",
    "POSTGRES_DB": "superset",
    "POSTGRES_PASSWORD": db_password,
})
write_secret("superset.env", {
    "SUPERSET_CONFIG_PATH": "/app/ns8_config.py",
    "SUPERSET_SECRET_KEY": secrets.token_hex(48),
    "SUPERSET_DATABASE_URI": f"postgresql+psycopg2://superset:{db_password}@127.0.0.1:5432/superset",
})
write_secret("admin.env", {
    "NS8_ADMIN_PASSWORD": secrets.token_urlsafe(24),
})
