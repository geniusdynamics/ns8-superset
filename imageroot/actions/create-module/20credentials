#!/usr/bin/env python3
import json
import os
from pathlib import Path
import secrets

state = Path(os.environ["AGENT_STATE_DIR"])
os.umask(0o077)
config = state / "superset.env"
if not config.exists():
    password = secrets.token_urlsafe(32)
    database_password = secrets.token_hex(32)
    key = secrets.token_urlsafe(32) + "="
    database_url = f"postgresql+psycopg2://superset:{database_password}@127.0.0.1/superset"
    values = {
        "POSTGRES_USER": "superset", "POSTGRES_DB": "superset",
        "POSTGRES_PASSWORD": database_password,
        "NS8_ADMIN_PASSWORD": password,
        "SUPERSET_CONFIG_PATH": "/app/ns8_config.py",
        "SUPERSET_SECRET_KEY": secrets.token_hex(48),
        "SUPERSET_DATABASE_URI": database_url,
    }
    config.write_text("".join(f"{name}={value}\n" for name, value in values.items()))
